# ---------- App ----------
APP_ENV=development
LOG_LEVEL=debug
SERVER_PORT=8080
PPROF_PORT=6060

# ---------- PostgreSQL ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=documind
DB_PASSWORD=documind
DB_NAME=documind
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Keycloak / OAuth2 ----------
OIDC_ISSUER_URL=http://keycloak:8080/realms/documind
OIDC_CLIENT_ID=documind-gateway
OIDC_AUDIENCE=documind-api
OIDC_JWKS_CACHE_TTL=15m

# ---------- Rate Limit ----------
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
RATE_LIMIT_WINDOW=1s

# ---------- Kafka ----------
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_DOCUMENTS=documind.documents.v1
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ---------- MinIO ----------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=documind
MINIO_SECRET_KEY=documind123
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ---------- gRPC ----------
SEARCH_SERVICE_GRPC_ADDR=search-service:50051
DOCUMENT_SERVICE_GRPC_ADDR=document-service:50052

# ---------- OpenTelemetry ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=documind-gateway
OTEL_SAMPLER_RATIO=1.0
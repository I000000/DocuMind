# ---------- App ----------
APP_ENV=development
LOG_LEVEL=debug
SERVER_PORT=8081
PPROF_PORT=6060

# ---------- Postgres ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=documind
DB_PASSWORD=documind
DB_NAME=documind
DB_SSLMODE=disable

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- OIDC / Keycloak ----------
OIDC_ISSUER_URL=http://localhost:8080/realms/documind
OIDC_CLIENT_ID=documind-gateway
OIDC_AUDIENCE=documind-api

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_DOCUMENTS=documind.documents.v1

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=documind
MINIO_SECRET_KEY=documind123
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ---------- Document Service ----------
DOCUMENT_HTTP_PORT=8082
DOCUMENT_GRPC_PORT=9090
DOCUMENT_PPROF_PORT=6062
DOCUMENT_MAX_UPLOAD_BYTES=52428800
DOCUMENT_SERVICE_GRPC_ADDR=localhost:9090
DOCUMENT_SERVICE_URL=http://localhost:8082
SEARCH_SERVICE_GRPC_ADDR=localhost:50051

# ---------- Outbox Worker ----------
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=10
OUTBOX_BACKOFF_BASE=1s
OUTBOX_BACKOFF_MAX=5m

# ---------- OpenTelemetry ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=documind-gateway
OTEL_SAMPLER_RATIO=1.0

# ---------- Rate Limit ----------
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
RATE_LIMIT_WINDOW=1s
# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
SERVER_PORT=8002

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_DOCUMENTS=documind.documents.v1
KAFKA_TOPIC_DLQ=documind.documents.v1.dlq
KAFKA_GROUP_ID=ai-worker-group
KAFKA_CONSUMER_WORKERS=3

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=documind
DB_PASSWORD=documind
DB_NAME=documind

# ---------- Redis ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=documind
MINIO_SECRET_KEY=documind123
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ---------- Retry ----------
MAX_RETRIES=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
IDEMPOTENCY_TTL_HOURS=24
SIMULATE_TRANSIENT_ERROR=false

# ---------- Embeddings ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# ---------- OCR ----------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=rus+eng